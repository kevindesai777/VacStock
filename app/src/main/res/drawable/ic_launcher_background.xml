<?xml version="1.0" encoding="utf-8"?>
<!-- Diagonal yellow → lilac → violet gradient. The end points span the visible 72dp, not the
     full 108dp layer, so the colors aren't cropped away by the launcher's mask. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="22"
                android:startY="22"
                android:endX="86"
                android:endY="86">
                <item
                    android:color="#FFEFD64A"
                    android:offset="0" />
                <item
                    android:color="#FFB98CC0"
                    android:offset="0.5" />
                <item
                    android:color="#FF5B3DF2"
                    android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
